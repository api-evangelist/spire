  "info": {
    "_postman_id": "b155c7b1-a8b3-42bb-870a-02f75ca77115",
    "name": "SPIRE OIDC Discovery Provider API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The SPIRE OIDC Discovery Provider is a helper component that exposes a minimal OpenID Connect discovery document and JSON Web Key Set (JWKS) endpoint. This allows workloads to present JWT-SVIDs issued by SPIRE to systems that support standard OIDC token validation, including cloud provider IAM systems such as AWS, GCP, and Azure. The provider derives its key material from the SPIRE Server or Agent trust bundle and serves it over HTTPS.\n\nContact Support:\n Name: SPIFFE Community",
      "type": "text/plain"
    }
  }
