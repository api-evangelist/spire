            "disableBodyPruning": true
          }
        }
      ],
      "event": []
    },
    {
      "id": "957f5741-2c21-4b08-9602-66328aa68649",
      "name": "Keys",
      "description": {
        "content": "JSON Web Key Set endpoint that exposes public keys used to verify JWT-SVIDs issued by SPIRE.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "cbedefdb-3c42-487b-9047-43ee1477fa7a",
          "name": "SPIRE Get JSON Web Key Set",
          "request": {
            "name": "SPIRE Get JSON Web Key Set",
            "description": {
              "content": "Returns the JSON Web Key Set (JWKS) containing the public keys used to verify JWT-SVIDs issued by SPIRE. The keys are derived from the SPIRE trust bundle and are automatically rotated as SPIRE rotates its signing keys. Consumers must re-fetch this endpoint periodically to stay current with key rotations. Supported signing algorithms include RS256, ES256, and ES384.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "keys"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The domain name configured for the OIDC discovery provider instance.",
                  "type": "any",
                  "value": "{{domain}}",
                  "key": "domain"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "82d3e489-f382-4b61-8c60-11a6b7e371d5",
              "name": "JSON Web Key Set containing public verification keys",
              "originalRequest": {
                "url": {
                  "path": [
                    "keys"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "description": "The domain name configured for the OIDC discovery provider instance.",
                      "type": "any",
                      "value": "{{domain}}",
                      "key": "domain"
                    }
                  ]
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"keys\": [\n    {\n      \"kty\": \"RSA\",\n      \"use\": \"sig\",\n      \"kid\": \"abc123def456\",\n      \"alg\": \"RS256\",\n      \"n\": \"string\",\n      \"e\": \"AQAB\",\n      \"crv\": \"P-256\",\n      \"x\": \"string\",\n      \"y\": \"string\"\n    },\n    {\n      \"kty\": \"RSA\",\n      \"use\": \"sig\",\n      \"kid\": \"abc123def456\",\n      \"alg\": \"RS256\",\n      \"n\": \"string\",\n      \"e\": \"AQAB\",\n      \"crv\": \"P-256\",\n      \"x\": \"string\",\n      \"y\": \"string\"\n    }\n  ]\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
