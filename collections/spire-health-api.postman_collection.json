          "id": "9708052a-8b16-4d24-a7f3-d381119b2ac0",
          "name": "SPIRE Liveness probe",
          "request": {
            "name": "SPIRE Liveness probe",
            "description": {
              "content": "Returns HTTP 200 if the SPIRE component process is alive and running. A non-200 response or connection failure indicates the process should be restarted. This endpoint is suitable for use as a Kubernetes livenessProbe. The path can be customized via the live_path configuration option (default: /live).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "live"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Address the health check listener binds to.",
                  "type": "any",
                  "value": "{{bind_address}}",
                  "key": "bind_address"
                },
                {
                  "description": "Port the health check listener binds to.",
                  "type": "any",
                  "value": "{{bind_port}}",
                  "key": "bind_port"
                }
              ]
            },
