  "info": {
    "_postman_id": "0bc2a104-7ffc-4f2a-aef2-d3baa748b3fc",
    "name": "SPIRE Health Check Discovery Keys API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "SPIRE Server and SPIRE Agent both expose an optional HTTP health checking endpoint that provides liveness and readiness probes. When enabled via the health_checks configuration block, the endpoint allows orchestrators such as Kubernetes to determine whether a SPIRE component is alive and ready to serve requests. The endpoint listens on a configurable address and port (defaulting to localhost:80) and exposes two paths: one for liveness and one for readiness.\n\nContact Support:\n Name: SPIFFE Community",
      "type": "text/plain"
    }
  }
